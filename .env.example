# Bot Command Prefix
PREFIX=!

# Google Chrome / Chromium executable path for Puppeteer
CHROME_PATH=/usr/bin/google-chrome

# Official FPL API Base URL
FPL_API_BASE=https://fantasy.premierleague.com/api

# WhatsApp Target Group Chat ID for automated periodic broadcasts (e.g. 120363xxxxxx@g.us)
TARGET_GROUP_ID=120363000000000000@g.us

# Bot Phone / WhatsApp JID (optional)
BOT_ID=

# Your FPL Classic Mini-League ID
LEAGUE_ID=629254
